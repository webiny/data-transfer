{
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["ES2022"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true
    },
    "include": ["projects/**/*.ts", "presets/**/*.ts", "transformers/**/*.ts"],
    "exclude": ["node_modules"]
}
