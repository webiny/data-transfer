# Copy to .env and fill in your values.
# .env is gitignored — credentials never get committed.

# --- Source environment ---
SOURCE_REGION=eu-central-1
SOURCE_PROFILE=default
SOURCE_DDB_TABLE=
SOURCE_S3_BUCKET=

# --- Target environment ---
TARGET_REGION=eu-central-1
TARGET_PROFILE=default
TARGET_DDB_TABLE=
TARGET_S3_BUCKET=

# --- OpenSearch (uncomment if used) ---
# SOURCE_OS_TABLE=
# TARGET_OS_TABLE=
# TARGET_OS_ENDPOINT=
# TARGET_OS_INDEX_PREFIX=

# --- Tuning ---
SEGMENTS=4
