# Copy this file to `.env` next to it. `.env*` is gitignored.
#
# AWS credentials come from ~/.aws/credentials via `fromAwsProfile` in
# the config files. Set *_PROFILE to pick a specific profile, or leave
# blank to use the `default` profile. If you prefer literal credentials
# instead, edit the config and swap `fromAwsProfile(...)` for a
# `{accessKeyId, secretAccessKey}` object — either shape is accepted.

# --- Source (v5 environment) ------------------------------------------------
SOURCE_REGION=us-east-1
# SOURCE_PROFILE=my-source-profile
SOURCE_DDB_TABLE=webiny-v5-table
SOURCE_S3_BUCKET=webiny-v5-files
SOURCE_OS_TABLE=webiny-v5-es-table

# --- Target (v6 environment) ------------------------------------------------
TARGET_REGION=us-east-1
# TARGET_PROFILE=my-target-profile
TARGET_DDB_TABLE=webiny-v6-table
TARGET_S3_BUCKET=webiny-v6-files
TARGET_OS_TABLE=webiny-v6-es-table
TARGET_OS_ENDPOINT=https://search-xxx.us-east-1.es.amazonaws.com

# --- Tuning ------------------------------------------------------------------
# Number of parallel worker processes (DDB parallel-scan segments).
SEGMENTS=4
