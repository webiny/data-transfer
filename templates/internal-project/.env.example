# Copy this file to `.env` next to it. `.env*` is gitignored.
# Run from the repo root:
#   yarn dev --config=./projects/{{PROJECT_NAME}}/ddb.transfer.config.ts
#   yarn dev --config=./projects/{{PROJECT_NAME}}/os.transfer.config.ts
#
# AWS credentials come from ~/.aws/credentials via `fromAwsProfile` inside
# the config files. Leave *_PROFILE blank to use the default profile.

# --- Source (v5 environment) ------------------------------------------------
SOURCE_REGION=eu-central-1
# SOURCE_PROFILE=my-source-profile
SOURCE_DDB_TABLE=webiny-v5-table
SOURCE_S3_BUCKET=webiny-v5-files
SOURCE_OS_TABLE=webiny-v5-es-table

# --- Target (v6 environment) ------------------------------------------------
TARGET_REGION=eu-central-1
# TARGET_PROFILE=my-target-profile
TARGET_DDB_TABLE=webiny-v6-table
TARGET_S3_BUCKET=webiny-v6-files
TARGET_OS_TABLE=webiny-v6-es-table
TARGET_OS_ENDPOINT=https://search-my-domain.eu-central-1.es.amazonaws.com
TARGET_OS_INDEX_PREFIX=

# --- Tuning ------------------------------------------------------------------
SEGMENTS=4
