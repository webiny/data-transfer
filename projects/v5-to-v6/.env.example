# Copy this file to `.env` next to it. `.env*` is gitignored.
# Run from the repo root:
#   yarn transfer --config=./projects/v5-to-v6/ddb.transfer.config.ts
#   yarn transfer --config=./projects/v5-to-v6/os.transfer.config.ts
#
# AWS credentials come from ~/.aws/credentials via `fromAwsProfile` inside
# the config files. Leave *_PROFILE blank to use the default profile.
# If you prefer literal creds, edit the config and swap `fromAwsProfile(...)`
# for a `{accessKeyId, secretAccessKey, sessionToken?}` object using
# fromEnv("..."); uncomment the *_AWS_* vars below too.

# --- Required IAM permissions ---------------------------------------------
#
# Source credentials need:
#   DynamoDB: Scan, Query, DescribeTable (on source primary + OS companion table)
#   S3:       GetObject (on source bucket objects), ListBucket (on source bucket)
#
# Target credentials need:
#   DynamoDB: BatchWriteItem, Query, DescribeTable (on target primary + OS companion table)
#   S3:       PutObject (on target bucket objects), ListBucket (on target bucket)
#   S3:       GetObject on the SOURCE bucket — CopyObject runs with target credentials
#
# Cross-account S3: if source and target are in different AWS accounts, add a
# bucket policy on the source bucket granting s3:GetObject to the target account.
# Without this, file copies will fail with AccessDenied.
#
# OpenSearch (if used): es:ESHttpGet, es:ESHttpPut, es:ESHttpPost on the target domain.
# Audit log table (if configured): BatchWriteItem, DescribeTable on the target table.

# --- Source (v5 environment) ------------------------------------------------
SOURCE_REGION=us-east-1
# SOURCE_PROFILE=my-source-profile
# SOURCE_AWS_ACCESS_KEY_ID=
# SOURCE_AWS_SECRET_ACCESS_KEY=
# SOURCE_AWS_SESSION_TOKEN=
SOURCE_DDB_TABLE=webiny-v5-table
SOURCE_S3_BUCKET=webiny-v5-files
SOURCE_ACCOUNT_ID=
SOURCE_AUDIT_LOGS_TABLE=
SOURCE_OS_TABLE=webiny-v5-es-table

# --- Target (v6 environment) ------------------------------------------------
TARGET_REGION=us-east-1
# TARGET_PROFILE=my-target-profile
# TARGET_AWS_ACCESS_KEY_ID=
# TARGET_AWS_SECRET_ACCESS_KEY=
# TARGET_AWS_SESSION_TOKEN=
TARGET_DDB_TABLE=webiny-v6-table
TARGET_S3_BUCKET=webiny-v6-files
TARGET_ACCOUNT_ID=
TARGET_AUDIT_LOGS_TABLE=webiny-v6-audit-logs
TARGET_OS_TABLE=webiny-v6-es-table
TARGET_OS_ENDPOINT=https://search-my-domain.us-east-1.es.amazonaws.com
TARGET_OS_INDEX_PREFIX=

# --- Tuning ------------------------------------------------------------------
# Number of parallel worker processes (DDB parallel-scan segments).
SEGMENTS=4
# Directory containing exported CMS model definitions (required for OS transfer).
# MODELS_DIR=./models
