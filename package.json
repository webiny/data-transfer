{
  "name": "@webiny/data-transfer",
  "version": "1.0.0",
  "description": "Webiny data transfer tool",
  "type": "module",
  "bin": {
    "webiny-data-transfer": "./bin.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "ts-check": "yarn tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**/**\"",
    "test:watch": "vitest",
    "format": "oxfmt",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "keywords": [
    "webiny",
    "data-transfer",
    "migration",
    "dynamodb",
    "opensearch"
  ],
  "author": "Webiny",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1037.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@webiny/api-headless-cms-ddb-es": "^6.2.0",
    "@webiny/api-opensearch": "^6.2.0",
    "@webiny/aws-sdk": "^6.2.0",
    "@webiny/di": "^0.2.3",
    "@webiny/lexical-converter": "^6.2.0",
    "@webiny/utils": "^6.2.0",
    "dotenv": "^17.4.2",
    "execa": "^9.6.1",
    "exifreader": "^4.38.1",
    "jsdom": "^29.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1037.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-dynamodb": "^3.1037.0",
    "@faker-js/faker": "^10.4.0",
    "@smithy/util-stream": "^4.5.25",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "4.1.5",
    "adio": "^3.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dynalite": "^4.0.0",
    "oxfmt": "^0.47.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
