{
  "name": "@webiny/v5-to-v6",
  "version": "1.0.0",
  "description": "Webiny v5 to v6 DynamoDB migration tool",
  "type": "module",
  "bin": "./bin.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "ts-check": "yarn tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**/**\"",
    "test:watch": "vitest"
  },
  "keywords": [
    "webiny",
    "migration",
    "dynamodb"
  ],
  "author": "Webiny",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/lib-dynamodb": "^3.1030.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@webiny/api-opensearch": "^6.1.0",
    "@webiny/lexical-converter": "^6.1.0",
    "execa": "^9.6.1",
    "exifreader": "^4.38.1",
    "jsdom": "^29.0.2",
    "minimatch": "^10.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "4.1.4",
    "dynalite": "^4.0.0",
    "jest-dynalite": "^3.6.1",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.13.0"
}
