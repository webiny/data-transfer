# --- Required IAM permissions -------------------------------------------------
#
# Source credentials need:
#   DynamoDB: Scan, Query, DescribeTable (on source primary + OS companion table)
#   S3:       GetObject (on source bucket objects), ListBucket (on source bucket)
#
# Target credentials need:
#   DynamoDB: BatchWriteItem, Query, DescribeTable (on target primary + OS companion table)
#   S3:       PutObject (on target bucket objects), ListBucket (on target bucket)
#   S3:       GetObject on the SOURCE bucket — CopyObject runs with target credentials
#
# Cross-account S3: if source and target are in different AWS accounts, add a
# bucket policy on the source bucket granting s3:GetObject to the target account.
# Without this, file copies will fail with AccessDenied.
#
# OpenSearch (if used): es:ESHttpGet, es:ESHttpPut, es:ESHttpPost on the target domain.
# Audit log table (if configured): BatchWriteItem, DescribeTable on the target table.

# AWS credentials for the source environment
SOURCE_AWS_ACCESS_KEY_ID=
SOURCE_AWS_SECRET_ACCESS_KEY=
# SOURCE_AWS_SESSION_TOKEN=

# AWS credentials for the target environment
TARGET_AWS_ACCESS_KEY_ID=
TARGET_AWS_SECRET_ACCESS_KEY=
# TARGET_AWS_SESSION_TOKEN=
